{
  "name": "ASCII Dragonflies",
  "description": "Dragonflies that hover, then dart. Click to send them off.",
  "entry": "index.html",
  "settings": [
    {
      "key": "count",
      "label": "Dragonflies",
      "type": "range",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 8
    },
    {
      "key": "speed",
      "label": "Dart speed",
      "type": "range",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "hover",
      "label": "Hover time",
      "type": "range",
      "min": 0.1,
      "max": 4,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "cursor",
      "label": "When the cursor is near",
      "type": "select",
      "default": "ignore",
      "options": [
        {
          "value": "curious",
          "label": "Dragonflies follow it"
        },
        {
          "value": "shy",
          "label": "Dragonflies flee from it"
        },
        {
          "value": "ignore",
          "label": "Dragonflies ignore it"
        }
      ]
    },
    {
      "key": "accent",
      "label": "Body colour",
      "type": "color",
      "default": "#4de0c8"
    },
    {
      "key": "cell",
      "label": "Character size",
      "type": "range",
      "min": 7,
      "max": 22,
      "step": 1,
      "default": 11
    },
    {
      "key": "theme",
      "label": "Background",
      "type": "select",
      "default": "deep",
      "options": [
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "deep",
          "label": "Deep teal"
        },
        {
          "value": "dusk",
          "label": "Dusk"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "paper",
          "label": "Paper"
        }
      ]
    },
    {
      "key": "shimmer",
      "label": "Drifting pollen",
      "type": "toggle",
      "default": true
    },
    {
      "key": "fps",
      "label": "Frame rate",
      "type": "select",
      "default": 60,
      "options": [
        {
          "value": 60,
          "label": "60 fps"
        },
        {
          "value": 30,
          "label": "30 fps (saves battery)"
        }
      ]
    }
  ]
}
