{
  "name": "ASCII Butterflies",
  "description": "Butterflies fluttering over the desktop. Click to scatter them.",
  "entry": "index.html",
  "settings": [
    {
      "key": "count",
      "label": "Butterflies",
      "type": "range",
      "min": 1,
      "max": 40,
      "step": 1,
      "default": 14
    },
    {
      "key": "speed",
      "label": "Flight speed",
      "type": "range",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "flutter",
      "label": "Flutter",
      "type": "range",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "flapRate",
      "label": "Flap rate",
      "type": "range",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "cursor",
      "label": "When the cursor is near",
      "type": "select",
      "default": "ignore",
      "options": [
        {
          "value": "curious",
          "label": "Butterflies follow it"
        },
        {
          "value": "shy",
          "label": "Butterflies flee from it"
        },
        {
          "value": "ignore",
          "label": "Butterflies ignore it"
        }
      ]
    },
    {
      "key": "accent",
      "label": "Wing colour",
      "type": "color",
      "default": "#5f9bff"
    },
    {
      "key": "variety",
      "label": "Mixed colours",
      "type": "toggle",
      "default": true
    },
    {
      "key": "cell",
      "label": "Character size",
      "type": "range",
      "min": 7,
      "max": 22,
      "step": 1,
      "default": 11
    },
    {
      "key": "theme",
      "label": "Background",
      "type": "select",
      "default": "night",
      "options": [
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "deep",
          "label": "Deep teal"
        },
        {
          "value": "dusk",
          "label": "Dusk"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "paper",
          "label": "Paper"
        }
      ]
    },
    {
      "key": "shimmer",
      "label": "Drifting pollen",
      "type": "toggle",
      "default": true
    },
    {
      "key": "fps",
      "label": "Frame rate",
      "type": "select",
      "default": 60,
      "options": [
        {
          "value": 60,
          "label": "60 fps"
        },
        {
          "value": 30,
          "label": "30 fps (saves battery)"
        }
      ]
    }
  ]
}
