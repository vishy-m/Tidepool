{
  "name": "ASCII Jellyfish",
  "description": "Jellyfish pulsing through dark water. Click the desktop to make the nearby ones jet away.",
  "entry": "index.html",
  "settings": [
    {
      "key": "count",
      "label": "Jellyfish",
      "type": "range",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 7
    },
    {
      "key": "speed",
      "label": "Drift speed",
      "type": "range",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "pulseRate",
      "label": "Pulse rate",
      "type": "range",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "glow",
      "label": "Pulse glow",
      "type": "range",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "arms",
      "label": "Arm length",
      "type": "range",
      "min": 0,
      "max": 2.5,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "cursor",
      "label": "When the cursor is near",
      "type": "select",
      "default": "ignore",
      "options": [
        {
          "value": "curious",
          "label": "Jellyfish follow it"
        },
        {
          "value": "shy",
          "label": "Jellyfish flee from it"
        },
        {
          "value": "ignore",
          "label": "Jellyfish ignore it"
        }
      ]
    },
    {
      "key": "accent",
      "label": "Jellyfish colour",
      "type": "color",
      "default": "#ff82d6"
    },
    {
      "key": "ripples",
      "label": "Ripples",
      "type": "toggle",
      "default": true
    },
    {
      "key": "cell",
      "label": "Character size",
      "type": "range",
      "min": 7,
      "max": 22,
      "step": 1,
      "default": 11
    },
    {
      "key": "theme",
      "label": "Background",
      "type": "select",
      "default": "dusk",
      "options": [
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "deep",
          "label": "Deep teal"
        },
        {
          "value": "dusk",
          "label": "Dusk"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "paper",
          "label": "Paper"
        }
      ]
    },
    {
      "key": "shimmer",
      "label": "Water shimmer",
      "type": "toggle",
      "default": true
    },
    {
      "key": "fps",
      "label": "Frame rate",
      "type": "select",
      "default": 60,
      "options": [
        {
          "value": 60,
          "label": "60 fps"
        },
        {
          "value": 30,
          "label": "30 fps (saves battery)"
        }
      ]
    }
  ]
}
