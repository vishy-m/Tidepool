{
  "name": "ASCII Crabs",
  "description": "Crabs scuttling sideways across the sand. Click to make them bolt.",
  "entry": "index.html",
  "settings": [
    {
      "key": "count",
      "label": "Crabs",
      "type": "range",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 9
    },
    {
      "key": "speed",
      "label": "Scuttle speed",
      "type": "range",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "rest",
      "label": "Pause length",
      "type": "range",
      "min": 0,
      "max": 4,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "scare",
      "label": "Scare",
      "type": "range",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "cursor",
      "label": "When the cursor is near",
      "type": "select",
      "default": "ignore",
      "options": [
        {
          "value": "curious",
          "label": "Crabs follow it"
        },
        {
          "value": "shy",
          "label": "Crabs flee from it"
        },
        {
          "value": "ignore",
          "label": "Crabs ignore it"
        }
      ]
    },
    {
      "key": "accent",
      "label": "Shell colour",
      "type": "color",
      "default": "#ef5b3c"
    },
    {
      "key": "cell",
      "label": "Character size",
      "type": "range",
      "min": 7,
      "max": 22,
      "step": 1,
      "default": 11
    },
    {
      "key": "theme",
      "label": "Background",
      "type": "select",
      "default": "sand",
      "options": [
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "deep",
          "label": "Deep teal"
        },
        {
          "value": "dusk",
          "label": "Dusk"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "paper",
          "label": "Paper"
        }
      ]
    },
    {
      "key": "shimmer",
      "label": "Sand grains",
      "type": "toggle",
      "default": true
    },
    {
      "key": "fps",
      "label": "Frame rate",
      "type": "select",
      "default": 60,
      "options": [
        {
          "value": 60,
          "label": "60 fps"
        },
        {
          "value": 30,
          "label": "30 fps (saves battery)"
        }
      ]
    }
  ]
}
